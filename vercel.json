{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [{ "source": "/((?!assets/|exercises.json|icon.svg|manifest.webmanifest|EXERCISES_LICENSE.txt).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/exercises.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
